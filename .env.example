# Copy to .env and adjust. Every setting is optional; defaults run fully offline (mock mode).
# Never commit .env.

MEDMEMORY_MODE=mock

# --- Component overrides (each defaults from MODE)
# MEDMEMORY_KV_BACKEND=sqlite            # sqlite | memory
# MEDMEMORY_VECTOR_STORE=memory          # memory | faiss
# MEDMEMORY_EMBEDDER=hashing             # hashing | sentence-transformers
# MEDMEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MEDMEMORY_RERANKER=lexical             # none | lexical | cross-encoder
# MEDMEMORY_GENERATOR=extractive         # extractive
# MEDMEMORY_ROUTER=rules                 # rules
# MEDMEMORY_DEVICE=auto                  # auto | cpu | cuda

# --- Cache & Thresholds
# MEDMEMORY_MIN_EVIDENCE_SCORE=0.55
# MEDMEMORY_CACHE_TTL_S=900

# --- API & Security Stub
# MEDMEMORY_AUTH_REQUIRED=false
# token:user:role, comma separated. This is a stub, not real authentication.
# MEDMEMORY_API_TOKENS=dev-clinician-token:dr.demo:clinician
# MEDMEMORY_RATE_LIMIT_PER_MINUTE=120
# MEDMEMORY_LOG_LEVEL=INFO
# MEDMEMORY_CORS_ORIGINS=["http://localhost:3000"]
